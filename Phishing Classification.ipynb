import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from statsmodels.stats.outliers_influence import variance_inflation_factor
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import f1_score, precision_score, recall_score, classification_report, confusion_matrix

# Set plot style
sns.set_theme(style="whitegrid")

# 1. Load Dataset
# Replace with the actual file path of the PhiUSIIL Phishing URL dataset
df_phish = pd.read_csv("PhiUSIIL_Phishing_URL_Dataset.csv") 

print("Initial Dataset Shape:", df_phish.shape)
df_phish.head()
# 1. Check and drop duplicate rows
duplicate_count = df_phish.duplicated().sum()
print(f"Duplicate rows identified and dropped: {duplicate_count}")
df_phish = df_phish.drop_duplicates()

# 2. Data Cleaning & Drop non-predictive columns (e.g., URL string, domain, IDs)
# Adjust non-predictive column names based on exact dataset schema if needed
drop_cols = ['id', 'URL', 'Domain', 'FILENAME', 'TLD']
df_clean = df_phish.drop(columns=[col for col in drop_cols if col in df_phish.columns], errors='ignore')

# Separate features and target
X = df_clean.drop(columns=['label'])  # Assuming 'label' is the binary target (0 or 1)
y = df_clean['label']

# 3. Missing Value Imputation
imputer = SimpleImputer(strategy='median')
X_imputed = pd.DataFrame(imputer.fit_transform(X), columns=X.columns)

# 4. EDA and Skewness Profiling (log-transform features with skewness > 2)
skewed_cols = [col for col in X_imputed.columns if X_imputed[col].skew() > 2]
print(f"Features transformed due to extreme skewness ({len(skewed_cols)}):", skewed_cols)

X_transformed = X_imputed.copy()
X_transformed[skewed_cols] = np.log1p(np.maximum(0, X_transformed[skewed_cols]))
def remove_high_vif_features(X_df, vif_threshold=10.0):
    """
    Iteratively calculates VIF and drops the highest collinear predictor 
    until all remaining features are below the threshold.
    """
    X_vif = X_df.copy()
    dropped_cols = []
    
    while True:
        # Calculate VIF for each column
        vif_series = pd.Series(
            [variance_inflation_factor(X_vif.values, i) for i in range(X_vif.shape[1])],
            index=X_vif.columns
        )
        
        max_vif = vif_series.max()
        if max_vif > vif_threshold:
            max_feature = vif_series.idxmax()
            dropped_cols.append(max_feature)
            X_vif = X_vif.drop(columns=[max_feature])
        else:
            break
            
    print(f"Total features dropped due to high multicollinearity (VIF > {vif_threshold}): {len(dropped_cols)}")
    return X_vif

# Apply iterative VIF feature elimination
X_reduced = remove_high_vif_features(X_transformed, vif_threshold=10.0)
print("Remaining features for modeling:", X_reduced.shape[1])
# 1. 80/20 Train-Test Split and Feature Scaling
X_train, X_test, y_train, y_test = train_test_split(
    X_reduced, y, test_size=0.20, random_state=42, stratify=y
)

scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# 2. Train Logistic Regression Model
model = LogisticRegression(max_iter=1000, random_state=42)
model.fit(X_train_scaled, y_train)

# Obtain predicted probabilities for the positive class (phishing = 1)
y_probs = model.predict_proba(X_test_scaled)[:, 1]

# 3. Custom Evaluation Script to Tune Decision Threshold τ
thresholds = np.arange(0.10, 0.90, 0.01)
f1_scores = []
precision_scores = []
recall_scores = []

best_tau = 0.5
best_f1 = 0.0

for tau in thresholds:
    # Classify based on custom threshold tau
    y_pred_custom = (y_probs >= tau).astype(int)
    
    f1 = f1_score(y_test, y_pred_custom)
    prec = precision_score(y_test, y_pred_custom, zero_division=0)
    rec = recall_score(y_test, y_pred_custom)
    
    f1_scores.append(f1)
    precision_scores.append(prec)
    recall_scores.append(rec)
    
    if f1 > best_f1:
        best_f1 = f1
        best_tau = tau

# Plot Threshold Optimization Curves
plt.figure(figsize=(8, 5))
plt.plot(thresholds, f1_scores, label="F1-Score", color="blue", linewidth=2)
plt.plot(thresholds, precision_scores, label="Precision", color="green", linestyle="--")
plt.plot(thresholds, recall_scores, label="Recall", color="orange", linestyle="--")
plt.axvline(best_tau, color="red", linestyle=":", label=f"Optimal Threshold (τ={best_tau:.2f})")

plt.xlabel("Decision Threshold (τ)")
plt.ylabel("Score")
plt.title("Custom Decision Threshold Tuning for F1-Score Optimization")
plt.legend()
plt.tight_layout()
plt.show()

# Print Final Evaluation Results
print("=== Final Threshold Evaluation Results ===")
print(f"Optimal Decision Threshold (τ) : {best_tau:.2f}")
print(f"Maximized Test F1-Score        : {best_f1:.4f} (Target Threshold: > 0.98)")

# Classification report at optimal threshold
final_preds = (y_probs >= best_tau).astype(int)
print("\nClassification Report (At Optimal Threshold):")
print(classification_report(y_test, final_preds, digits=4))

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score, mean_squared_error

# Set plot style
sns.set_theme(style="whitegrid")

# 1. Load Dataset
df = pd.read_csv("UNSW-NB15-training-set.csv")  # Make sure the file is in your working directory

print("Dataset Shape:", df.shape)
df.head()
# 1. Data Cleaning & Column Selection
# Drop identifier columns and ground truth classification targets
drop_cols = ['id', 'attack_cat', 'label']
df_clean = df.drop(columns=[col for col in drop_cols if col in df.columns])

# Separate features and target variable ('dur')
X = df_clean.drop(columns=['dur'])
y = df_clean['dur']

# 2. Perform 80/20 Train-Test Split (before scaling/imputation to prevent leakage)
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42
)

# 3. Visualizing Target Distribution before transformation
plt.figure(figsize=(10, 4))
plt.subplot(1, 2, 1)
sns.histplot(y_train, kde=True, bins=30)
plt.title("Original Target Variable ('dur') Distribution")

# 4. Skewness Transformation for Target
# Log-transform target 'dur' (y' = log(y + 1))
y_train_log = np.log1p(np.maximum(0, y_train))
y_test_log = np.log1p(np.maximum(0, y_test))

plt.subplot(1, 2, 2)
sns.histplot(y_train_log, kde=True, bins=30)
plt.title("Log-Transformed Target Variable ('dur')")
plt.tight_layout()
plt.show()

# 5. Skewness Transformation for Continuous Features (skewness > 2)
num_cols = X_train.select_dtypes(include=[np.number]).columns
cat_cols = X_train.select_dtypes(include=['object', 'category']).columns

skewed_cols = [col for col in num_cols if X_train[col].skew() > 2]
print(f"Features with skewness > 2 ({len(skewed_cols)}):", skewed_cols)

# Apply log1p transformation to heavily skewed continuous features
X_train_transformed = X_train.copy()
X_test_transformed = X_test.copy()

X_train_transformed[skewed_cols] = np.log1p(np.maximum(0, X_train_transformed[skewed_cols]))
X_test_transformed[skewed_cols] = np.log1p(np.maximum(0, X_test_transformed[skewed_cols]))

# 6. Imputation, Encoding & Scaling Pipelines
num_pipeline = Pipeline([
    ('imputer', SimpleImputer(strategy='median')),
    ('scaler', StandardScaler())
])

cat_pipeline = Pipeline([
    ('imputer', SimpleImputer(strategy='most_frequent')),
    ('encoder', OneHotEncoder(drop='first', handle_unknown='ignore', sparse_output=False))
])

preprocessor = ColumnTransformer([
    ('num', num_pipeline, num_cols),
    ('cat', cat_pipeline, cat_cols)
])

# Fit on training data and transform both sets
X_train_proc = preprocessor.fit_transform(X_train_transformed)
X_test_proc = preprocessor.transform(X_test_transformed)

print("Processed Training Features Shape:", X_train_proc.shape)
class BatchGradientDescentLinearRegression:
    def __init__(self, learning_rate=0.01, iterations=2000):
        self.lr = learning_rate
        self.iterations = iterations
        self.weights = None
        self.bias = None
        self.cost_history = []

    def fit(self, X, y):
        n_samples, n_features = X.shape
        self.weights = np.zeros(n_features)
        self.bias = 0.0

        for i in range(self.iterations):
            # Linearity hypothesis: h(x) = X*w + b
            y_pred = np.dot(X, self.weights) + self.bias
            
            # Compute Mean Squared Error Cost
            cost = (1 / (2 * n_samples)) * np.sum((y_pred - y) ** 2)
            self.cost_history.append(cost)

            # Compute Gradients
            dw = (1 / n_samples) * np.dot(X.T, (y_pred - y))
            db = (1 / n_samples) * np.sum(y_pred - y)

            # Gradient Step
            self.weights -= self.lr * dw
            self.bias -= self.lr * db

    def predict(self, X):
        return np.dot(X, self.weights) + self.bias

# Fit model from scratch
scratch_model = BatchGradientDescentLinearRegression(learning_rate=0.05, iterations=3000)
scratch_model.fit(X_train_proc, y_train_log.values)

# Predict on test set
scratch_preds = scratch_model.predict(X_test_proc)

# Plot training cost over iterations
plt.figure(figsize=(6, 4))
plt.plot(scratch_model.cost_history)
plt.xlabel("Iteration")
plt.ylabel("MSE Cost")
plt.title("Gradient Descent Cost Convergence")
plt.show()
# 1. Scikit-Learn Linear Regression
sk_model = LinearRegression()
sk_model.fit(X_train_proc, y_train_log)

sk_preds = sk_model.predict(X_test_proc)

# 2. Evaluation Metrics Calculation
def evaluate_performance(y_true, y_pred, model_name="Model"):
    r2 = r2_score(y_true, y_pred)
    rmse = np.sqrt(mean_squared_error(y_true, y_pred))
    print(f"--- {model_name} Evaluation ---")
    print(f"R² Score : {r2:.4f}  (Target: > 0.83)")
    print(f"RMSE     : {rmse:.4f}  (Target: < 0.39)")
    return r2, rmse

scratch_r2, scratch_rmse = evaluate_performance(y_test_log, scratch_preds, "Scratch Gradient Descent")
print()
sk_r2, sk_rmse = evaluate_performance(y_test_log, sk_preds, "Scikit-Learn LinearRegression")

# Comparison Table
results = pd.DataFrame({
    'Metric': ['R² Score', 'RMSE'],
    'Target Threshold': ['> 0.83', '< 0.39'],
    'Scratch Implementation': [f"{scratch_r2:.4f}", f"{scratch_rmse:.4f}"],
    'Scikit-Learn Implementation': [f"{sk_r2:.4f}", f"{sk_rmse:.4f}"]
})

results
